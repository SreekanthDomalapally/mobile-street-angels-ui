EXPO_PUBLIC_API_URL=https://street-angels-api-production.up.railway.app/api/v1
# Optional override; defaults to {API_ORIGIN}/ws/alerts/{alert_id}?token=...
EXPO_PUBLIC_WS_URL=wss://street-angels-api-production.up.railway.app/ws/alerts

# Firebase project: youhoo-alert-app (see street-angels-api/firebase/)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=youhoo-alert-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=youhoo-alert-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=youhoo-alert-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1065150630879
# Android: 1:1065150630879:android:83296463ab35f7f73f526a | iOS: 1:1065150630879:ios:07795a288c9f5fa03f526a
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Web OAuth client ID (client_type 3 from google-services.json).
# MUST match Railway GOOGLE_OAUTH_CLIENT_ID on the API.
# youhoo-alert-app Web client:
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1065150630879-prjdgu45hcopbcdbt6dr2c2sbt24u4kn.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS: @sreekanth.domalapally/mobile-youhoo-alert
EXPO_PUBLIC_EAS_PROJECT_ID=d37e827f-a71b-47c3-b0df-a2b912af8063

# Google Maps: restrict keys to package com.youhooalert.com (Android) + bundle com.youhooalert.com (iOS)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Optional crash reporting (install @sentry/react-native for full integration)
EXPO_PUBLIC_SENTRY_DSN=
