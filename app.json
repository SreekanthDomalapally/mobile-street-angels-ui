{
  "expo": {
    "name": "Street Angels",
    "slug": "mobile-street-angels-ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "streetangels",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.streetangels.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Street Angels uses your location only during active SOS alerts to share with trusted responders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location is used during emergencies to help trusted contacts find you.",
        "UIBackgroundModes": ["location", "remote-notification"]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyB61yKLKHL1TZNAu4IoZb4ZDvcrzeFOhz0"
      }
    },
    "android": {
      "package": "com.streetangels.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB61yKLKHL1TZNAu4IoZb4ZDvcrzeFOhz0"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f0f12"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Street Angels to use your location during active alerts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#c94a4a",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
