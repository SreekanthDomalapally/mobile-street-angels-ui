{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "global.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "website/**",
    "__tests__/**",
    "app.config.ts"
  ]
}
